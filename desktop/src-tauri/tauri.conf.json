{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyraShield Local",
  "version": "1.2.0",
  "identifier": "dev.lyrashield.local",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LyraShield Local",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.lyrashield.dev https://github.com https://*.githubusercontent.com; frame-src 'none'; object-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "LyraShield Local — local security scanning",
    "longDescription": "LyraShield Local is a desktop app that runs the LyraShield engine locally with your own AI keys. Bring your own ChatGPT subscription or Azure OpenAI deployment.",
    "publisher": "LyraShield"
  },
  "plugins": {
    "updater": {
      "pubkey": "LYRASHIELD_UPDATER_ED25519_PUBKEY_PLACEHOLDER",
      "endpoints": [
        "https://github.com/lyrashield/lyrashield-local/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
