--- /dev/null
+++ b/pkg/iac/scanners/cloudformation/parser/parameter_skip_test.go
@@ -0,0 +1,30 @@
+package parser
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"encoding/json/jsontext"
+)
+
+// The Go1.27 replacement for SkipFunc must leave the decoder input untouched.
+func TestUnmarshalIntFirstUnsupportedPreservesInput(t *testing.T) {
+	for _, input := range []string{`"text"`, `true`, `null`, `[1,2]`, `{"key":"value"}`} {
+		t.Run(input, func(t *testing.T) {
+			dec := jsontext.NewDecoder(strings.NewReader(input))
+			before := dec.InputOffset()
+			var value any
+			if err := unmarshalIntFirst(dec, &value); !errors.Is(err, errors.ErrUnsupported) {
+				t.Fatalf("expected fallback, got %v", err)
+			}
+			if dec.InputOffset() != before || value != nil {
+				t.Fatalf("fallback consumed input or changed target: offset=%d value=%v", dec.InputOffset(), value)
+			}
+			raw, err := dec.ReadValue()
+			if err != nil || string(raw) != input {
+				t.Fatalf("fallback altered next value: %s, %v", raw, err)
+			}
+		})
+	}
+}
